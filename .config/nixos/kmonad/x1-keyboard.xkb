(defcfg
  input (device-file "/dev/input/by-path/platform-i8042-serio-0-event-kbd")
  output (uinput-sink "Frogs X1-Keyboard KMonad output")
  cmp-seq ralt
  fallthrough true
  allow-cmd false)


(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt kprt rctl
)
 
(defalias
  arr (tap-macro nlck (layer-toggle arrow))
  lhp (tap-next tab lmet)
  rhp (tap-next \ rmet)
)

(deflayer default
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  @lhp q    w    e    r    t    y    u    i    o    p    [    ]    @rhp
  @arr a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt kprt rctl    
)

(deflayer arrow
  _    _    _    _    _    _    _    _    _    _    _    _    _    del
  _    _    _    _    _    _    _    _    up   _    _    _    _    _
  _    _    _    _    _    _    _    left down rght _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)
