default partial
xkb_symbols "custom-frog" { 
    name[Group1] = "custom";

    include "pc+us+us:2+inet(evdev)+group(shifts_toggle)+level3(ralt_switch_multikey)+ctrl(nocaps)+typo(base):1+typo(base):2"
    
    key <AC01> { [         a,          A,    adiaeresis,       Adiaeresis ] };
    key <AD07> { [         u,          U,    udiaeresis,       Udiaeresis ] };
    key <AD09> { [         o,          O,    odiaeresis,       Odiaeresis ] };
    key <AC02> { [         s,          S,        ssharp,          section ] };
};